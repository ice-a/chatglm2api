# chatglm-panel 环境变量示例
# 复制为 .env 后按需修改；.env 不会提交到版本库。
# 已存在的系统/容器环境变量优先级高于本文件。

# 监听地址（容器内必须 0.0.0.0 才能被外部访问）
HOST=0.0.0.0

# 监听端口
PORT=8788

# 是否自动打开浏览器（服务器/容器环境请置 0）
PANEL_OPEN_BROWSER=0

# 数据目录（账号 / 配置 / 日志），默认 ./data
# 支持相对路径（相对程序目录）或绝对路径
# DATA_DIR=./data

# 初始 API Key：设置后会覆盖 data/config.json 中保存的值；留空则使用已保存/自动生成
# API_KEY=sk-xxxxxxxxxxxxxxxx
