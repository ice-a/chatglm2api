# 运行时数据（含账号 token、API Key、日志，切勿提交）
data/

# 前端构建依赖与产物（源码在 web/，构建后由 npm run build 生成 public/index.html）
web/node_modules/
web/dist/
public/index.html

# 打包中间产物
node_modules/
*.blob
sea-config.json

# 打包产物（如需分发可自行保留）
*.exe

# 日志与临时文件
*.log
*.tmp
.DS_Store
Thumbs.db

# 本地环境变量（含密钥，切勿提交；.env.example 为模板可提交）
.env
.env.local
